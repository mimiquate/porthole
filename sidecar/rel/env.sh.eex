#!/bin/sh
# Defaults so that, in the common case, only RELEASE_COOKIE, PORTHOLE_TOKENS
# and DNS_CLUSTER_QUERY need to be set.

# Long names (name@10.0.1.12), as clusters that discover each other by
# address use.
export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-name}"

# Name the sidecar after this machine's address: Kubernetes (POD_IP, from the
# downward API), Fly.io (FLY_PRIVATE_IP), or the first address of the host.
if [ -z "$RELEASE_NODE" ]; then
  ip="${POD_IP:-${FLY_PRIVATE_IP:-$(hostname -i 2>/dev/null | awk '{print $1}')}}"
  if [ -n "$ip" ]; then
    export RELEASE_NODE="porthole@$ip"
  fi
fi
